# The Dockerfile only COPYs named paths; this file keeps the build context
# small and keeps secrets out of it entirely.

.git
.github
.venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.pyright
.coverage
htmlcov
dist
build
*.egg-info

# Secrets and local config never enter the build context.
.env
.env.*
*.pem
*.key

tests
docs
scripts
openapi.json
docker-compose*.yml
Dockerfile
.dockerignore
.idea
.vscode
.DS_Store

# The on-chain workspace is built separately from the Python service.
solana
