{
  // Local development and checks. Run from the Command Palette:
  // "Tasks: Run Task", then pick one. Start with "dev: start all".
  // Everything here is local: Postgres, ElasticMQ (local SQS) and Mailpit
  // (local SMTP, web UI on http://localhost:8025) come from docker compose.
  "version": "2.0.0",
  "options": {
    "env": {
      // boto3 signs requests even for ElasticMQ; any value works locally.
      "AWS_ACCESS_KEY_ID": "local",
      "AWS_SECRET_ACCESS_KEY": "local",
      "AGNO_TELEMETRY": "false"
    }
  },
  "tasks": [
    {
      "label": "dev: services up",
      "detail": "Creates .env from .env.example if missing; Postgres, Mailpit and ElasticMQ in docker compose",
      "type": "shell",
      "command": "(test -f .env || (cp .env.example .env && echo 'created .env from .env.example')) && docker compose up -d --wait db mailpit elasticmq",
      "problemMatcher": []
    },
    {
      "label": "dev: migrate",
      "detail": "alembic upgrade head (as bido_migrator)",
      "type": "shell",
      "command": "uv run alembic upgrade head",
      "problemMatcher": []
    },
    {
      "label": "dev: seed",
      "detail": "Dev tenant, buyer + approver users, two suppliers (idempotent)",
      "type": "shell",
      "command": "uv run python scripts/seed_dev.py",
      "problemMatcher": []
    },
    {
      "label": "dev: api",
      "detail": "FastAPI on http://localhost:8080 (docs at /docs), auto-reload",
      "type": "shell",
      "command": "uv run uvicorn bido_back.api.app:create_app --factory --reload --port 8080",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^__never__$" },
        "background": {
          "activesBegin": "Will watch for changes",
          "beginsPattern": "Will watch for changes",
          "endsPattern": "Application startup complete"
        }
      },
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "dev: worker",
      "detail": "SQS worker: approvals, sends, mailbox sync, extraction, onboarding jobs",
      "type": "shell",
      "command": "uv run python -m bido_back.worker",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^__never__$" },
        "background": { "beginsPattern": ".", "endsPattern": "." }
      },
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "dev: start all",
      "detail": "Services, migrations, seed, then api + worker side by side",
      "dependsOrder": "sequence",
      "dependsOn": ["dev: services up", "dev: migrate", "dev: seed", "dev: api + worker"],
      "problemMatcher": []
    },
    {
      "label": "dev: api + worker",
      "dependsOn": ["dev: api", "dev: worker"],
      "problemMatcher": []
    },
    {
      "label": "front: dev (local API)",
      "detail": "bido-front (sibling folder ../bido-front) on http://localhost:3000, calling the local API on :8080",
      "type": "shell",
      "command": "pnpm install --frozen-lockfile && pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/../bido-front",
        "env": { "NEXT_PUBLIC_API_URL": "http://localhost:8080" }
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^__never__$" },
        "background": { "beginsPattern": "next dev|Starting", "endsPattern": "Ready in|ready" }
      },
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "front: dev (AWS dev API)",
      "detail": "bido-front on http://localhost:3000, calling https://api.dev.usebido.com (no local backend needed)",
      "type": "shell",
      "command": "pnpm install --frozen-lockfile && pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/../bido-front",
        "env": { "NEXT_PUBLIC_API_URL": "https://api.dev.usebido.com" }
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^__never__$" },
        "background": { "beginsPattern": "next dev|Starting", "endsPattern": "Ready in|ready" }
      },
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "dev: full stack",
      "detail": "Services, migrations, seed, then api + worker + frontend (needs Clerk settings in .env, see README)",
      "dependsOrder": "sequence",
      "dependsOn": ["dev: services up", "dev: migrate", "dev: seed", "dev: api + worker + front"],
      "problemMatcher": []
    },
    {
      "label": "dev: api + worker + front",
      "dependsOn": ["dev: api", "dev: worker", "front: dev (local API)"],
      "problemMatcher": []
    },
    {
      "label": "dev: supplier reply",
      "detail": "Answer the latest RFQ email in Mailpit with a synthetic quote (xlsx) via /dev/inbound",
      "type": "shell",
      "command": "uv run python scripts/dev_reply.py",
      "problemMatcher": []
    },
    {
      "label": "dev: reset database (deletes local data)",
      "detail": "docker compose down -v, then services up, migrate and seed again",
      "type": "shell",
      "command": "docker compose down -v && docker compose up -d --wait db mailpit elasticmq && uv run alembic upgrade head && uv run python scripts/seed_dev.py",
      "problemMatcher": []
    },
    {
      "label": "dev: seed motor demo",
      "detail": "Local demo company Motori Demo S.p.A.: EV motor BOM, stock, 12 months of purchases (idempotent)",
      "type": "shell",
      "command": "uv run python scripts/seed_motor_demo.py",
      "problemMatcher": []
    },
    {
      "label": "aws: login (SSO)",
      "detail": "IAM Identity Center login; the aws dev tasks below use it",
      "type": "shell",
      "command": "aws sso login --sso-session bido",
      "problemMatcher": []
    },
    {
      "label": "aws dev: health",
      "detail": "GET https://api.dev.usebido.com/health",
      "type": "shell",
      "command": "curl -sS -m 10 https://api.dev.usebido.com/health && echo",
      "problemMatcher": []
    },
    {
      "label": "aws dev: status",
      "detail": "api/worker running vs desired tasks and the rollout state",
      "type": "shell",
      "command": "aws ecs describe-services --profile ${input:awsProfile} --region us-east-2 --cluster bido-dev --services api worker --query 'services[].[serviceName,runningCount,desiredCount,deployments[0].rolloutState]' --output table",
      "problemMatcher": []
    },
    {
      "label": "aws dev: logs api",
      "detail": "Follow the api logs (last 15 min)",
      "type": "shell",
      "command": "aws logs tail /ecs/bido-dev/api --profile ${input:awsProfile} --region us-east-2 --since 15m --follow",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "aws dev: logs worker",
      "detail": "Follow the worker logs (last 15 min)",
      "type": "shell",
      "command": "aws logs tail /ecs/bido-dev/worker --profile ${input:awsProfile} --region us-east-2 --since 15m --follow",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "aws dev: dead letters",
      "detail": "Messages in the -dlq queues = jobs that failed 5 times",
      "type": "shell",
      "command": "for q in bido-jobs-dlq bido-intake-dlq bido-parking-dlq; do url=$(aws sqs get-queue-url --profile ${input:awsProfile} --region us-east-2 --queue-name $q --query QueueUrl --output text) && echo \"$q: $(aws sqs get-queue-attributes --profile ${input:awsProfile} --region us-east-2 --queue-url $url --attribute-names ApproximateNumberOfMessages --query Attributes.ApproximateNumberOfMessages --output text)\"; done",
      "problemMatcher": []
    },
    {
      "label": "aws dev: deploy main",
      "detail": "Run the Deploy (dev) workflow on main and watch it (GitHub CLI)",
      "type": "shell",
      "command": "gh workflow run deploy-dev.yml --ref main && sleep 5 && gh run watch $(gh run list --workflow deploy-dev.yml --limit 1 --json databaseId --jq '.[0].databaseId') --exit-status",
      "problemMatcher": []
    },
    {
      "label": "eval: run (mock)",
      "detail": "Agent evals on synthetic spreadsheets with scripted model outputs (harness check, free)",
      "type": "shell",
      "command": "uv run python -m evals.run --mock",
      "problemMatcher": []
    },
    {
      "label": "eval: run (live)",
      "detail": "Agent evals against the live model (OPENAI_API_KEY; k=3, a few minutes, small cost)",
      "type": "shell",
      "command": "uv run python -m evals.run",
      "problemMatcher": []
    },
    {
      "label": "check: lint + types",
      "type": "shell",
      "command": "uv run ruff check && uv run ruff format --check && uv run pyright",
      "problemMatcher": []
    },
    {
      "label": "check: tests",
      "detail": "Full pytest; database tests need 'dev: services up' and 'dev: migrate'",
      "type": "shell",
      "command": "uv run pytest -q",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "check: RLS + OpenAPI",
      "detail": "Forced RLS on every tenant table; regenerate openapi.json",
      "type": "shell",
      "command": "uv run python scripts/check_rls.py && uv run python scripts/export_openapi.py && git diff --stat openapi.json",
      "problemMatcher": []
    },
    {
      "label": "check: everything (pre-PR)",
      "dependsOrder": "sequence",
      "dependsOn": ["check: lint + types", "check: RLS + OpenAPI", "check: tests"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "awsProfile",
      "type": "promptString",
      "description": "AWS CLI profile for the dev account (see README: Deploy (dev))",
      "default": "bido-dev-temp"
    }
  ]
}
