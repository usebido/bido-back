# Local configuration. Copy to `.env` (git-ignored) and adjust:
#
#   cp .env.example .env
#
# Every key maps to a field in src/bido_back/settings.py. In AWS these values
# come from the ECS task definition and Secrets Manager; never put real
# credentials in this file.

# One of: local, test, dev, prd.
ENVIRONMENT=local

# App role (bido_app): owns no tables, cannot CREATE, has no BYPASSRLS.
# Used by the api and the worker. Port 54320 is the compose `db` service.
DATABASE_URL=postgresql+asyncpg://bido_app:app@localhost:54320/bido

# Migration role (bido_migrator): owns the schema. Used only by Alembic.
MIGRATION_DATABASE_URL=postgresql+asyncpg://bido_migrator:migrator@localhost:54320/bido

# Agno role (bido_agno): owns only the `agno` schema, where Agno keeps its
# sessions, memory and runs. No access to the business tables.
AGNO_DATABASE_URL=postgresql+asyncpg://bido_agno:agno@localhost:54320/bido
# Agno's own usage telemetry phones home by default; keep it off everywhere.
# Exception to the rule above: Agno reads this from the process environment,
# not settings.py, and `.env` only feeds Settings, so the agents adapter also
# passes telemetry=False explicitly. Docker, compose and CI set the env var.
AGNO_TELEMETRY=false

# AWS region for SQS and other AWS clients.
AWS_REGION=eu-central-1

# Queues. Locally they are ElasticMQ (`docker compose up -d elasticmq`, see
# docker/elasticmq.conf). boto3 needs dummy credentials to sign for it, and it
# reads them from the process environment, not from this file:
#   export AWS_ACCESS_KEY_ID=local AWS_SECRET_ACCESS_KEY=local
# In AWS leave SQS_ENDPOINT_URL unset; the task role signs for the real queues.
SQS_ENDPOINT_URL=http://localhost:9324
# Jobs the worker consumes (approval.execute, quote.extract, fx.refresh, mailbox.sync).
SQS_QUEUE_URL=http://localhost:9324/000000000000/bido-jobs
# Raw inbound emails (SES -> S3 -> this queue); optional, the consumer is off when unset.
SQS_INTAKE_QUEUE_URL=http://localhost:9324/000000000000/bido-intake
# Where unhandleable messages are parked (otherwise hidden 12h until DLQ redrive).
SQS_PARKING_QUEUE_URL=http://localhost:9324/000000000000/bido-parking

# Email. EMAIL_DOMAIN names our Message-IDs and Bido reply addresses.
EMAIL_DOMAIN=quotes.usebido.com
# How RFQ emails go out: "mailbox" (the buyer's connected Gmail / Microsoft 365,
# the product behavior), or "smtp" / "ses" (local and test only; From is the
# buyer's address). Locally "smtp" sends to Mailpit (UI http://localhost:8025),
# so you can try the flow without connecting a mailbox.
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025

# Blob storage for raw emails and attachments: "local" (a directory) or "s3".
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=.data/blobs
# S3_BUCKET=<bucket-name>

# Auth (Clerk). Locally, AUTH_DEV_MODE=true accepts `X-Dev-User: <clerk_user_id>`
# (see scripts/seed_dev.py) instead of a Clerk token; refused unless
# ENVIRONMENT=local. With Clerk, set all three below.
AUTH_DEV_MODE=true
# CLERK_ISSUER=https://<instance>.clerk.accounts.dev
# CLERK_JWKS_URL=https://<instance>.clerk.accounts.dev/.well-known/jwks.json
# CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]

# Buyer mailbox connections (OAuth). Needed only with EMAIL_TRANSPORT=mailbox.
# Register the redirect URI <OAUTH_REDIRECT_BASE_URL>/v1/mailbox/callback/<google|microsoft>
# with each provider.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
# The frontend page the callback forwards the code and state to; it finishes
# the link with POST /v1/mailbox/complete as the signed-in user.
MAILBOX_CONNECT_RETURN_URL=http://localhost:3000/settings/mailbox
# Encrypts stored OAuth tokens and signs the OAuth state. Locally a Fernet key:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=
# In AWS, tokens are encrypted under this KMS key instead (required in prd).
# OAUTH_TOKEN_KMS_KEY_ID=alias/<key-alias>
MAILBOX_SYNC_INTERVAL_SECONDS=120

# OpenAI API key for the agent runner. Leave empty unless you need live
# model calls; tests must not depend on it.
OPENAI_API_KEY=

# Observability. Both are off when unset, which is the normal local setup.
# OTLP/HTTP collector base URL (the app appends /v1/traces). In AWS this is the
# ADOT sidecar, which forwards to CloudWatch.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=bido-back
# Sentry for errors only (no tracing). Never point a local run at production.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
