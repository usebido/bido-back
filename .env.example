# Local configuration. Copy to `.env` (git-ignored) and adjust:
#
#   cp .env.example .env
#
# Every key maps to a field in src/bido_back/settings.py. In AWS these values
# come from the ECS task definition and Secrets Manager; never put real
# credentials in this file.

# One of: local, test, dev, prd.
ENVIRONMENT=local

# App role (bido_app): owns no tables, cannot CREATE, has no BYPASSRLS.
# Used by the api and the worker. Port 54320 is the compose `db` service.
DATABASE_URL=postgresql+asyncpg://bido_app:app@localhost:54320/bido

# Migration role (bido_migrator): owns the schema. Used only by Alembic.
MIGRATION_DATABASE_URL=postgresql+asyncpg://bido_migrator:migrator@localhost:54320/bido

# Agno role (bido_agno): owns only the `agno` schema, where Agno keeps its
# sessions, memory and runs. No access to the business tables.
AGNO_DATABASE_URL=postgresql+asyncpg://bido_agno:agno@localhost:54320/bido
# Agno's own usage telemetry phones home by default; keep it off everywhere.
# Exception to the rule above: Agno reads this from the process environment,
# not settings.py, and `.env` only feeds Settings, so the agents adapter also
# passes telemetry=False explicitly. Docker, compose and CI set the env var.
AGNO_TELEMETRY=false

# AWS region for SQS and other AWS clients.
AWS_REGION=eu-central-1

# Queue the worker consumes. Leave unset locally unless you point it at a
# real (non-production) queue; an empty value would be read as "".
# SQS_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/<account-id>/<queue-name>
# Optional: where unhandleable messages are parked (otherwise hidden 12h until DLQ redrive).
# SQS_PARKING_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/<account-id>/<parking-queue-name>

# Anthropic API key for the agent runner. Leave empty unless you need live
# model calls; tests must not depend on it.
ANTHROPIC_API_KEY=

# Observability. Both are off when unset, which is the normal local setup.
# OTLP/HTTP collector base URL (the app appends /v1/traces). In AWS this is the
# ADOT sidecar, which forwards to CloudWatch.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=bido-back
# Sentry for errors only (no tracing). Never point a local run at production.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
